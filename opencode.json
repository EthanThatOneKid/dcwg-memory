{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/nemotron-free",
  "small_model": "openrouter/nemotron-free",
  "provider": {
    "openrouter": {
      "models": {
        "nemotron-free": {
          "id": "nvidia/nemotron-3-super-120b-a12b:free",
          "name": "Nemotron 3 Super 120B (free)"
        }
      }
    }
  },
  "agent": {
    "dcwg": {
      "description": "Maintains the dcwg-memory wiki from a Discord capture. Read-only outside wiki/.",
      "mode": "primary",
      "prompt": "{file:./tools/discord/prompt/dcwg.md}",
      "steps": 24,
      "permission": {
        "edit": "allow",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "bash": "deny",
        "task": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "question": "deny",
        "external_directory": "deny"
      }
    }
  }
}
